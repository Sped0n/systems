{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test extensions/*/test.ts",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-deps.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "tree-sitter-bash": "0.25.1",
    "typebox": "1.3.37",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

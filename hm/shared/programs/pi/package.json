{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --import tsx --test extensions/*/test.ts",
    "typecheck": "tsc --noEmit",
    "update:runtime-deps": "node scripts/update-runtime-deps.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "tree-sitter-bash": "0.25.1",
    "typebox": "1.3.7",
    "web-tree-sitter": "0.26.13"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "oxfmt": "0.67.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}

{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "useUnknownInCatchVariables": true
  },
  "include": ["extensions/**/*.ts", "scripts/**/*.ts"]
}
